# GENERATION_PROVIDER selects the answering model: gemini (default, free-tier hosted,
# needs GOOGLE_API_KEY) | ollama (local, no key needed, zero cost) | anthropic (Claude
# Haiku, needs ANTHROPIC_API_KEY). Embeddings are always local (bge-small) regardless.
GENERATION_PROVIDER=gemini

# Only set this to true if embedding/model downloads fail with an SSL certificate
# error — some antivirus/proxy software (e.g. Avast Web Shield) intercepts HTTPS with
# a root cert that fails a stricter OpenSSL 3.2+ check. Leave false/unset otherwise.
RELAX_SSL_VERIFICATION=false

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
